{
  "server": {
    "http_port": 8080,
    "https_port": 8443,
    "run_mode": "persist",
    "allow_https_over_http_port": false
  },
  "tls": {
    "certificate": "cert/server.crt",
    "private_key": "cert/server.key"
  },
  "upstream": {
    "host": "api.binance.com",
    "port": 443,
    "ignore_certificate_verification": false
  },
  "logging": {
    "output": "console",
    "level": "info"
  },
  "throttling": {
    "enabled": false,
    "requests_per_second": 20,
    "burst_size": 40
  }
}
